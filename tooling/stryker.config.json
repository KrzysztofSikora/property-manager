{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node_modules/.bin/vitest run -c tooling/vitest.config.ts --exclude \"**/guardrails.test.ts\""
  },
  "coverageAnalysis": "off",
  "mutate": [],
  "ignorePatterns": ["/apps", "/packages", "/docs", "/context", "/reports"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/tooling/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/tooling/mutation.json"
  }
}
