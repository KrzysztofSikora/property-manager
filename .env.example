# Copy to .env and fill in. Only WEATHERSTACK_KEY is required; the rest show their defaults.

# Weatherstack API access key (required). Never commit or print it.
WEATHERSTACK_KEY=

# Weatherstack base URL. E2E points it at the stub.
# WEATHERSTACK_BASE_URL=https://api.weatherstack.com

# PostgreSQL connection URL (matches the docker-compose postgres service).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/property_manager

# API HTTP port.
# PORT=4000

# pino log level: fatal, error, warn, info, debug, trace or silent.
# LOG_LEVEL=info
