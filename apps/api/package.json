  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "msw": "^3.0.2",
    "vitest": "^5.0.3"
  }
